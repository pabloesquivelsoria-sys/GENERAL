{
  "uid": "bbs-kpis",
  "title": "BBS - KPIs",
  "tags": [
    "bbs",
    "ehs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "graphTooltip": 1,
  "description": "KPIs de Behavior-Based Safety sobre vistas bi.* (rol bbs_readonly).",
  "templating": {
    "list": [
      {
        "name": "site",
        "label": "Sitio",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "bbs-pg"
        },
        "query": "SELECT DISTINCT site_code FROM bi.v_observations UNION SELECT DISTINCT site_code FROM bi.v_near_misses UNION SELECT DISTINCT site_code FROM bi.v_capa ORDER BY 1",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "% comportamiento seguro",
      "description": "safe / (safe + at_risk) en el rango",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bbs-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bbs-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT round(100.0*sum(safe_count)/NULLIF(sum(evaluated_count),0),1) AS safe_rate FROM bi.v_safe_behavior_daily WHERE $__timeFilter(day) AND site_code IN ($site)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      }
    },
