    {
      "id": 7,
      "type": "timeseries",
      "title": "Tendencia semanal de % seguro",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bbs-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bbs-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT date_trunc('week', day)::timestamp AS time, round(100.0*sum(safe_count)/NULLIF(sum(evaluated_count),0),2) AS \"% seguro\" FROM bi.v_safe_behavior_daily WHERE $__timeFilter(day) AND site_code IN ($site) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "Observaciones por dia (seguro vs riesgo)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bbs-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bbs-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT day::timestamp AS time, sum(safe_count) AS seguros, sum(at_risk_count) AS en_riesgo FROM bi.v_safe_behavior_daily WHERE $__timeFilter(day) AND site_code IN ($site) GROUP BY 1 ORDER BY 1"
        }
      ],
      "options": {
        "stacking": "normal",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "xTickLabelRotation": -45
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "en_riesgo"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "seguros"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Top 10 comportamientos en riesgo",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bbs-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bbs-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT behavior, count(*) AS en_riesgo FROM bi.v_observation_behaviors WHERE result = 'at_risk' AND $__timeFilter(observed_at) AND site_code IN ($site) GROUP BY 1 ORDER BY 2 DESC LIMIT 10"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true,
          "fields": "/^en_riesgo$/"
        }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "color": {
            "mode": "continuous-YlRd"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "piechart",
      "title": "Near-miss por severidad potencial",
      "datasource": {
        "type": "grafana-postgresql-datasource",
