    {
      "id": 12,
      "type": "table",
      "title": "CAPA vencidas",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bbs-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bbs-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT reference AS referencia, priority AS prioridad, status AS estado, owner_name AS responsable, site_code AS sitio, due_date AS vence, days_overdue AS dias_vencida, escalation_level AS escalamiento FROM bi.v_capa WHERE is_overdue AND site_code IN ($site) ORDER BY days_overdue DESC LIMIT 50"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "dias_vencida",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "dias_vencida"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "yellow",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 7
                    },
                    {
                      "color": "red",
                      "value": 14
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
