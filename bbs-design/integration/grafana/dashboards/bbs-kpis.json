            "uid": "bbs-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT potential_severity, count(*) AS total FROM bi.v_near_misses WHERE $__timeFilter(occurred_at) AND site_code IN ($site) GROUP BY 1"
        }
      ],
      "options": {
        "pieType": "donut",
        "legend": {
