# Copiar a .env y ajustar. Valores de desarrollo: NO usar en produccion.
COMPOSE_PROJECT_NAME=bbs-integration

# --- PostgreSQL (una instancia, tres bases: bbs, traccar, metabase) ---
POSTGRES_PASSWORD=postgres_dev_pw
BBS_DB_PASSWORD=bbs_dev_pw
BBS_READONLY_PASSWORD=bbs_ro_dev_pw
TRACCAR_DB_PASSWORD=traccar_dev_pw
METABASE_DB_PASSWORD=metabase_dev_pw
# true = carga db/seeds (roles, catalogos, sitio demo)
BBS_LOAD_SEEDS=true

# --- API BBS (perfil "full") ---
JWT_SECRET=dev_only_change_me_to_a_long_random_string
# URL con la que Traccar alcanza la API. Con perfil "full": http://api:3000
# Si corres la API en tu host:  http://host.docker.internal:3000
BBS_API_URL=http://api:3000
# Token compartido Traccar -> BBS (cabecera X-BBS-Webhook-Token)
BBS_WEBHOOK_TOKEN=dev_webhook_token_change_me

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
