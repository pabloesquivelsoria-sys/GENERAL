# Copiar a .env y ajustar:  cp .env.example .env
# --- PostgreSQL ---
POSTGRES_USER=bbs
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=bbs
POSTGRES_PORT=5432
# true aplica db/seeds (001 catálogos/roles/reglas de escalamiento; 002 sitio DEMO). En producción usa false
# tras la primera carga y crea tus propios sitios.
SEED=true

# --- API ---
API_PORT=3000
# openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h
# El primer usuario registrado es admin; luego puedes cerrar el auto-registro.
ALLOW_SELF_REGISTER=true
# Orígenes CORS separados por coma (vacío = cualquiera)
CORS_ORIGINS=

# --- Escalamiento / alertas ---
SCHEDULER_ENABLED=true          # barrido cada 10 min + snapshot KPI nocturno
ALERT_DUE_SOON_DAYS=3           # aviso de CAPA por vencer
VERIFICATION_PENDING_DAYS=3     # días en verificación antes de alertar al verificador
REPEAT_UNSAFE_THRESHOLD=3       # at_risk repetidos (mismo comportamiento y área) para alerta de reincidencia
REPEAT_UNSAFE_WINDOW_DAYS=30
CAPA_MAX_EXTENSIONS=2

# --- Solo desarrollo local sin Docker (npm run start:dev en api/) ---
# DATABASE_URL=postgres://bbs:cambia-esto@localhost:5432/bbs
# REDIS_URL=redis://localhost:6379
# PORT=3000
