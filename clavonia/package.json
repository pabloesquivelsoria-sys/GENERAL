{
  "name": "clavonia",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter @clavonia/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @clavonia/db run generate",
    "db:migrate": "pnpm --filter @clavonia/db run migrate",
    "db:seed": "pnpm --filter @clavonia/db run seed"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "prettier": "^3",
    "typescript": "^5.6",
    "typescript-eslint": "^8",
    "vitest": "^2"
  }
}
